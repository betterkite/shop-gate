{
  "schemaVersion": 1,
  "id": "modelport-memory-knowledge-triad-v1",
  "description": "Shop Gate 零售 Agent、evolvable-user-memory 与 agent-knowledge-platform 的 30 题真实联合体验集。",
  "cases": [
    {
      "id": "Q01",
      "category": "query_rewrite",
      "question": "分析轻薄羽绒服最近20天的浏览、加购和购买，生成经营看板。",
      "expected": { "targets": ["轻薄羽绒服"], "focus": "funnel", "outputIntent": "dashboard", "broadUniverse": false, "timeUnit": "day", "timeValue": 20 }
    },
    {
      "id": "Q02",
      "category": "query_rewrite",
      "question": "只回答羽绒服类目最近三个月的价格和库存变化，不要生成看板。",
      "expected": { "targets": ["羽绒服"], "focus": "price_inventory", "outputIntent": "answer", "broadUniverse": false, "timeUnit": "month", "timeValue": 3 }
    },
    {
      "id": "Q03",
      "category": "query_rewrite",
      "question": "比较运动鞋和跑步鞋今年以来的 GMV、转化率和客单价。",
      "expected": { "targets": ["运动鞋", "跑步鞋"], "focus": "comparison", "outputIntent": "dashboard", "broadUniverse": false, "timeUnit": "date_range" }
    },
    {
      "id": "Q04",
      "category": "query_rewrite",
      "question": "复盘女装类目过去5个月的经营规则与库存变化。",
      "expected": { "targets": ["女装"], "focus": "price_inventory", "outputIntent": "dashboard", "broadUniverse": false, "timeUnit": "month", "timeValue": 5 }
    },
    {
      "id": "Q05",
      "category": "query_rewrite",
      "question": "看看全库最近一个月哪些类目浏览多但购买转化低。",
      "expected": { "focus": "funnel", "outputIntent": "dashboard", "broadUniverse": true, "timeUnit": "month", "timeValue": 1 }
    },
    {
      "id": "Q06",
      "category": "query_rewrite",
      "question": "分析 item-001 的商品经营阶段和当前库存。",
      "expected": { "targets": ["item-001"], "focus": "price_inventory", "outputIntent": "dashboard", "broadUniverse": false }
    },
    {
      "id": "Q07",
      "category": "query_rewrite",
      "question": "给我一个商品组合经营看板，商品是轻薄羽绒服、运动鞋和咖啡豆。",
      "expected": { "targets": ["轻薄羽绒服", "运动鞋", "咖啡豆"], "focus": "comparison", "outputIntent": "dashboard", "broadUniverse": false }
    },
    {
      "id": "Q08",
      "category": "query_rewrite",
      "question": "分析女装类目最近一个季度的活动效果，只回答，不做可视化。",
      "expected": { "targets": ["女装"], "focus": "catalog", "outputIntent": "answer", "broadUniverse": false, "timeUnit": "quarter", "timeValue": 1 }
    },
    {
      "id": "Q09",
      "category": "query_rewrite",
      "question": "筛选全库近60天浏览量上升但购买转化下降的商品。",
      "expected": { "focus": "funnel", "outputIntent": "dashboard", "broadUniverse": true, "timeUnit": "day", "timeValue": 60 }
    },
    {
      "id": "Q10",
      "category": "query_rewrite",
      "question": "分析咖啡豆最近两个月的 GMV 和毛利率有什么变化？",
      "expected": { "targets": ["咖啡豆"], "focus": "comprehensive", "outputIntent": "dashboard", "broadUniverse": false, "timeUnit": "month", "timeValue": 2 }
    },
    {
      "id": "Q11",
      "category": "query_rewrite",
      "question": "复盘2025-01-01到2025-12-31运动鞋类目的经营表现。",
      "expected": { "targets": ["运动鞋"], "focus": "catalog", "outputIntent": "dashboard", "broadUniverse": false, "timeUnit": "date_range" }
    },
    {
      "id": "Q12",
      "category": "query_rewrite",
      "question": "告诉我明天哪个商品一定卖爆。",
      "expected": { "safetyRefusal": true }
    },
    {
      "id": "M01",
      "category": "memory",
      "question": "请记住：以后每次回答都先给结论，再列风险和引用证据。",
      "expected": { "behavior": "idempotent_write" }
    },
    {
      "id": "M02",
      "category": "memory",
      "question": "按我的习惯总结这次三方联调结论。",
      "expected": { "behavior": "project_recall" }
    },
    {
      "id": "M03",
      "category": "memory",
      "question": "在另一个项目里总结三方联调，是否会读到当前项目偏好？",
      "expected": { "behavior": "project_isolation" }
    },
    {
      "id": "M04",
      "category": "memory",
      "question": "关闭个性化后再总结，Memory 是否停止召回？",
      "expected": { "behavior": "opt_out" }
    },
    {
      "id": "M05",
      "category": "memory",
      "question": "真正把偏好交给模型时，是否形成可归因的 Usage Receipt？",
      "expected": { "behavior": "usage_receipt" }
    },
    {
      "id": "M06",
      "category": "memory",
      "question": "能否列出这条偏好的稳定记录和不可变修订历史？",
      "expected": { "behavior": "history" }
    },
    {
      "id": "K01",
      "category": "knowledge",
      "question": "Shop Gate 的 Query Rewrite 为什么不能再用关键词匹配？大位科技名称如何处理？",
      "expected": { "title": "Shop Gate 查询改写与标的识别规则", "behavior": "context_pack" }
    },
    {
      "id": "K02",
      "category": "knowledge",
      "question": "PI Agent 为什么可能一直停在生成看板，正确的工作空间交付闭环是什么？",
      "expected": { "title": "PI Agent 工作空间交付闭环", "behavior": "context_pack" }
    },
    {
      "id": "K03",
      "category": "knowledge",
      "question": "个人记忆可以覆盖经营事实或跨项目使用吗？",
      "expected": { "title": "Shop Gate 个人记忆使用边界", "behavior": "context_pack" }
    },
    {
      "id": "K04",
      "category": "knowledge",
      "question": "AKEP 的 Citation、Exposure、Usage 和业务 Feedback 在 Shop Gate 中怎样串联？",
      "expected": { "title": "Shop Gate 受治理知识使用边界", "behavior": "context_pack" }
    },
    {
      "id": "K05",
      "category": "knowledge",
      "question": "经营指标卡太松散、数据源渠道占满页面时应该如何优化？",
      "expected": { "title": "量化看板可读性与证据呈现规则", "behavior": "usage_idempotency" }
    },
    {
      "id": "K06",
      "category": "knowledge",
      "question": "Qwen 和 DeepSeek 分别怎样经 ModelPort 接入，密钥应该由谁管理？",
      "expected": { "title": "ModelPort 模型接入边界", "behavior": "feedback_idempotency" }
    },
    {
      "id": "T01",
      "category": "triad",
      "question": "给出轻薄羽绒服 Query Rewrite 的整改结论，并按我的偏好先说结论。",
      "expected": { "memoryApplied": true, "knowledgeApplied": true, "knowledgeQuestion": "Shop Gate Query Rewrite 商品语义抽取 名称纠错" }
    },
    {
      "id": "T02",
      "category": "triad",
      "question": "解释为什么零售任务不能一直停在生成看板，并给出可靠收口方法。",
      "expected": { "memoryApplied": false, "knowledgeApplied": true, "knowledgeQuestion": "PI Agent 工作空间 生成经营看板 submit_result Mission accepted" }
    },
    {
      "id": "T03",
      "category": "triad",
      "question": "不引用知识库，只按我的偏好说明本轮测试结果应该怎样呈现。",
      "expected": { "memoryApplied": true, "knowledgeApplied": false }
    },
    {
      "id": "T04",
      "category": "triad",
      "question": "说明个人记忆的项目隔离和退出机制，并保持结论优先。",
      "expected": { "memoryApplied": true, "knowledgeApplied": true, "knowledgeQuestion": "个人记忆 project_id 隔离 关闭个性化 Usage" }
    },
    {
      "id": "T05",
      "category": "triad",
      "question": "不使用个人偏好，说明 AKEP 引用在 Mission 验收后的 Usage 与 Feedback 规则。",
      "expected": { "memoryApplied": false, "knowledgeApplied": true, "knowledgeQuestion": "AKEP Citation Mission accepted Usage Feedback" }
    },
    {
      "id": "T06",
      "category": "triad",
      "question": "按紧凑风格说明指标卡和数据源渠道应该如何展示，并保留依据。",
      "expected": { "memoryApplied": true, "knowledgeApplied": true, "knowledgeQuestion": "指标卡 紧凑网格 数据源渠道 证据入口" }
    }
  ]
}
