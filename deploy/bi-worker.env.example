# Dedicated worker only. Copy privately to /etc/shopgate/bi-worker.env with mode 0600.
# Do not copy the Web/API environment, model credentials or administrator DB URL.
SHOPGATE_BI_WORKER_DATABASE_URL=""
SHOPGATE_BI_SERVICE_SECRET=""
SHOPGATE_BI_AUTH_ORIGIN="http://127.0.0.1:3000"
SHOPGATE_BI_DEMO_ENABLED="0"
