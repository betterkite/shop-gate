# Private Web <-> commerce-data scope signing. Same random 32+ bytes on both
# services; never NEXT_PUBLIC, never a browser/model credential.
SHOPGATE_BI_SERVICE_SECRET=
# Explicit non-superuser/NOBYPASSRLS connection for the v0.1 ledger; no DATABASE_URL fallback.
# Apply the reviewed ledger migrations separately. Normal service startup does not migrate/reset.
SHOPGATE_BI_DATABASE_URL=
# Only enables explicitly confirmed creation/generation of separate demo datasets.
# Formal imports never get generated facts. Leave disabled outside demo environments.
SHOPGATE_BI_DEMO_ENABLED=0
# Independent worker login, explicitly granted the NOLOGIN shopgate_bi_worker group
# and scoped ledger table access. Never superuser/BYPASSRLS; no fallback connection.
SHOPGATE_BI_WORKER_DATABASE_URL=
# Fixed Web origin for current-session/policy revalidation; no credentials/path/query.
SHOPGATE_BI_AUTH_ORIGIN=
