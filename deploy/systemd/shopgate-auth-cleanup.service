[Unit]
Description=Shop Gate expired auth data and audit retention cleanup
After=network-online.target

[Service]
Type=oneshot
User=shopgate
Group=shopgate
WorkingDirectory=/opt/shopgate/current
EnvironmentFile=/etc/shopgate/shopgate.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env npm run auth:cleanup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/commercepilot /opt/shopgate/current/tmp
