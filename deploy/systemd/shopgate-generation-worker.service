[Unit]
Description=Shop Gate durable Data Agent generation worker
After=network-online.target shopgate-commerce-data.service
Wants=network-online.target
Requires=shopgate-commerce-data.service

[Service]
Type=simple
User=shopgate
Group=shopgate
WorkingDirectory=/opt/shopgate/current
EnvironmentFile=/etc/shopgate/shopgate.env
Environment=NODE_ENV=production
Environment=PI_AGENT_DISPATCH_MODE=worker
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/env node scripts/checks/check-production-readiness.js
ExecStart=/usr/bin/env npm run worker:generation
Restart=on-failure
RestartSec=5s
TimeoutStopSec=180s
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/commercepilot /opt/shopgate/current/tmp /opt/shopgate/current/public/uploads
LimitNOFILE=65536
