[Unit]
Description=Refresh Shop Gate trading calendar and daily market data
After=network-online.target shopgate-commerce-data.service
Wants=network-online.target
Requires=shopgate-commerce-data.service

[Service]
Type=oneshot
User=shopgate
Group=shopgate
WorkingDirectory=/opt/shopgate/current
EnvironmentFile=/etc/shopgate/shopgate.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env npm run market:maintain
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/commercepilot /opt/shopgate/current/tmp
