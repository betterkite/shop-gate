[Unit]
Description=Shop Gate standalone web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shopgate
Group=shopgate
WorkingDirectory=/opt/shopgate/current
EnvironmentFile=/etc/shopgate/shopgate.env
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/env node scripts/checks/check-production-readiness.js
ExecStart=/usr/bin/env node .next/standalone/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/commercepilot /opt/shopgate/current/tmp /opt/shopgate/current/public/uploads /opt/shopgate/current/.next/standalone/.next/cache
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
